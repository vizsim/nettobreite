# --- Secrets ---
.env

# --- Daten (rohe + abgeleitete Artefakte; liegen lokal + später B2, nicht im Git) ---
# data/* (NICHT data/): ignoriert die Inhalte, lässt git aber ins Verzeichnis hinab,
# damit die Negationen unten greifen (data/ würde das Verzeichnis komplett sperren).
data/*
*.parquet
*.fgb
*.gpkg
*.pbf
*.osm.pbf
*.geojson
*.geojson.gz

# Ausnahmen: das Manifest + die finalen PMTiles werden vorerst über GitHub gehostet
# (B2 erst bei ganz-Deutschland) -> ins Git. Reihenfolge: erst Verzeichnis wieder
# reinnehmen, dann dessen Inhalt sperren, dann gezielt die .pmtiles freigeben.
!data/manifest.json
!data/nettobreite/
data/nettobreite/*
!data/nettobreite/*.pmtiles

# Golden-Referenz gehört ins Git (klein): JSON-Kennzahlen + eingefrorene Stichprobe
!tests/golden/*.json
!tests/golden/*.parquet

# --- Python / uv ---
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# --- OS / Editor ---
.DS_Store
.idea/
.vscode/
