# Kopiere diese Datei nach `.env` (ist via .gitignore ausgeschlossen) und trage
# die echten Werte ein. NIEMALS `.env` committen.

# --- Backblaze B2 (für PMTiles-Upload via `nettobreite deploy`) ---
# Application Key unter https://secure.backblaze.com/app_keys.htm anlegen und auf
# den Ziel-Bucket beschränken (Read+Write), NICHT den Master-Key benutzen.
# Der applicationKey wird nur einmal angezeigt → direkt hier speichern.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=nettobreite-data

# --- Mapillary (Street-View-Coverage im Viewer) ---
# Der alte, im Repo (js/config/config.public.js) veröffentlichte Token gilt als
# kompromittiert → unter https://www.mapillary.com/dashboard/developers neu erzeugen.
MAPILLARY_TOKEN=

# MAPTILER_API_KEY entfällt komplett (keyless: OpenFreeMap + Mapterhorn).
